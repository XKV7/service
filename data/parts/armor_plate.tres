[gd_resource type="Resource" script_class="PartData" format=3]

[ext_resource type="Script" path="res://core/stats/part_data.gd" id="1_part"]
[ext_resource type="Script" path="res://core/stats/part_level.gd" id="2_lvl"]
[ext_resource type="Script" path="res://core/stats/stat_modifier.gd" id="3_mod"]

[sub_resource type="Resource" id="StatModifier_0_0"]
script = ExtResource("3_mod")
stat = &"max_hp"
op = 0
value = 20.0

[sub_resource type="Resource" id="PartLevel_0"]
script = ExtResource("2_lvl")
modifiers = Array[ExtResource("3_mod")]([SubResource("StatModifier_0_0")])
effect_value = 0.0
effect_value_2 = 0.0
description = "최대 내구도 +20"

[sub_resource type="Resource" id="StatModifier_1_0"]
script = ExtResource("3_mod")
stat = &"max_hp"
op = 0
value = 20.0

[sub_resource type="Resource" id="StatModifier_1_1"]
script = ExtResource("3_mod")
stat = &"hurt_invuln"
op = 0
value = 0.2

[sub_resource type="Resource" id="PartLevel_1"]
script = ExtResource("2_lvl")
