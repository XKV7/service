[gd_resource type="Resource" script_class="PartData" format=3]

[ext_resource type="Script" path="res://core/stats/part_data.gd" id="1_part"]
[ext_resource type="Script" path="res://core/stats/part_level.gd" id="2_lvl"]
[ext_resource type="Script" path="res://core/stats/stat_modifier.gd" id="3_mod"]

[sub_resource type="Resource" id="StatModifier_0_0"]
script = ExtResource("3_mod")
stat = &"hack_stun_duration"
op = 0
value = 0.5

[sub_resource type="Resource" id="PartLevel_0"]
script = ExtResource("2_lvl")
modifiers = Array[ExtResource("3_mod")]([SubResource("StatModifier_0_0")])
effect_value = 0.0
effect_value_2 = 0.0
description = "시스템 정지 지속 +0.5초"

[sub_resource type="Resource" id="StatModifier_1_0"]
script = ExtResource("3_mod")
stat = &"hack_stun_duration"
op = 0
value = 1.0

[sub_resource type="Resource" id="PartLevel_1"]
script = ExtResource("2_lvl")
modifiers = Array[ExtResource("3_mod")]([SubResource("StatModifier_1_0")])
effect_value = 0.0
effect_value_2 = 0.0
description = "시스템 정지 지속 +1.0초"

[sub_resource type="Resource" id="StatModifier_2_0"]
script = ExtResource("3_mod")
stat = &"hack_stun_duration"
op = 0
value = 1.5

[sub_resource type="Resource" id="StatModifier_2_1"]
script = ExtResource("3_mod")
stat = &"hack_reach"
op = 0
value = 40.0

[sub_resource type="Resource" id="PartLevel_2"]
script = ExtResource("2_lvl")
modifiers = Array[ExtResource("3_mod")]([SubResource("StatModifier_2_0"), SubResource("StatModifier_2_1")])
effect_value = 0.0
effect_value_2 = 0.0
description = "지속 +1.5초, 범위 +40px"

[resource]
script = ExtResource("1_part")
id = &"cooling_fin"
display_name = "냉각 핀"
description = "시스템 정지 지속 시간과 범위를 늘린다."
levels = Array[ExtResource("2_lvl")]([SubResource("PartLevel_0"), SubResource("PartLevel_1"), SubResource("PartLevel_2")])
upgrade_costs = Array[int]([200, 500])
