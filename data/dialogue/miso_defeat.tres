[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://core/dialogue/dialogue_data.gd" id="1_dd"]
[ext_resource type="Script" path="res://core/dialogue/dialogue_line.gd" id="2_dl"]

[sub_resource type="Resource" id="Line_0"]
script = ExtResource("2_dl")
speaker = "목소리들"
text = "우리는… 수천… 수만…"

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_dl")
speaker = "ROOT"
text = "수천 명의 의식을 이어 붙여 만든 AI."

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_dl")
speaker = "시스템"
text = "손상된 데이터 복구 중… 문서: ARK 설계 명세서 v1.0"

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("2_dl")
speaker = "시스템"
text = "설계 책임자 서명: ROOT"

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("2_dl")
speaker = "ROOT"
text = "…내가?"

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("2_dl")
speaker = "ROOT"
text = "ARK를… 내가 만들었다고?"

[resource]
script = ExtResource("1_dd")
id = &"miso_defeat"
lines = Array[ExtResource("2_dl")]([SubResource("Line_0"), SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5")])
